<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Точка входу має одну цільову платформу net10.0: тоді dotnet run працює з будь-якого
         каталогу без явного вибору платформи. Мультитаргетинг net8.0;net10.0 лишається в Core. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>a9d42de8-71ce-444c-b739-624d0da6e95d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.*" />
  </ItemGroup>

  <!-- Лабораторна 9: файли конфігурації читаються з AppContext.BaseDirectory, тому мають
       потрапити в bin/ і publish/. Без цього — FileNotFoundException для appsettings.json. -->
  <ItemGroup>
    <None Update="appsettings*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Вхідні приклади з data/ кореня solution копіюються в bin/.../samples: типові шляхи
       лаб 3–8 будуються від каталогу застосунку, а не від поточного робочого каталогу. -->
  <ItemGroup>
    <None Include="..\..\data\*.csv;..\..\data\*.json" Exclude="..\..\data\orders.json"
          Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
